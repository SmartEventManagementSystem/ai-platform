# ========================================
# EMS AI Platform Environment Variables
# ========================================

# Server Configuration
PORT=8081
ENVIRONMENT=development
METRICS_ENABLED=true
METRICS_PORT=9091

# HuggingFace Configuration (FREE TIER - No API key needed)
# Get your free API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Model Options (all free):
# - mistralai/Mistral-7B-Instruct-v0.2 (8K context)
# - mistralai/Mistral-7B-Instruct-v0.3 (128K context)
# - meta-llama/Llama-3.1-8B-Instruct (128K context)
# - meta-llama/Llama-3.2-3B-Instruct (128K context)
# - Qwen/Qwen2.5-7B-Instruct (32K context)
# - Qwen/Qwen2.5-14B-Instruct (32K context)
# - microsoft/Phi-3-mini-128k-instruct (128K context)
# - google/gemma-2-9b-it (8K context)
# - openchat/openchat-7b
# - teknium/OpenHermes-2.5-Mistral-7B
# - WizardLM/WizardLM-2-8x22B
# - NousResearch/Hermes-3-Llama-3.1-8B

# Vector Database (Qdrant for RAG)
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION=ems_events

# Kafka Configuration
KAFKA_BROKERS=localhost:9092

# Redis Configuration
REDIS_URL=localhost:6379

# Event Service URL
EVENT_SERVICE_URL=http://localhost:8080

# MCP (Model Context Protocol) Configuration
MCP_ENABLED=true
MCP_GATEWAY_URL=http://localhost:8082
MCP_API_KEY=
